    <string name="module_hero_badge">在您的电视上显示其卡片</string>
    <string name="module_add">添加到{tv}</string>
    <!-- Shown before the first add-on download (F-Droid Inclusion Policy, security item 5). -->
    <string name="module_outside_store">附加组件从其作者的 GitHub 版本下载，不在任何应用商店中，且未由 F-Droid 构建或检查。</string>
    <string name="module_add_turns_cards_on">添加此功能后，此电视的主屏幕将启用卡片；在显示卡片之前，电视会先征求您的意见。</string>
    <string name="module_paused_reason">维护者已暂停：{reason}</string>
    <string name="module_install_adding">正在添加{name}……</string>
    <string name="module_install_downloading">{size, plural, other {正在下载（# MB）……}}</string>
    <string name="module_install_checking">正在检查是否与作者的副本相符……</string>
    <string name="module_install_installing">正在电视上安装……</string>
    <string name="module_install_asking">正在要求电视显示其问题……</string>

    <string name="addmodule_open_source">开放源代码</string>
    <string name="addmodule_size">{size, plural, other {# MB}}</string>
    <string name="addmodule_tier_community">粉丝论坛</string>
    <string name="addmodule_tier_verified">已驗證</string>
    <string name="addmodule_tier_paused">已暂停</string>

<?xml version='1.0' encoding='UTF-8'?>
<!--
  Clean Your TV, :feature:modules. English source strings.
  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
  no Android plurals elements. Counts go through the plural selector.
  Screens: M3, M3a, M3b, M3c, update re-consent, the index and fetch failure lines.
  Module names, publisher handles and index text are data and are never put in these strings.
--><resources>

    <!-- Shared button words -->
    <string name="action_back">返回</string>
    <string name="action_cancel">取消</string>
    <string name="action_ok">确定</string>
    <string name="action_done">完成</string>
    <string name="action_undo">撤销</string>

    <!-- Credential prompt (D17), raised by "Add to {tv}" -->
    <string name="gate_title">确认您的身份</string>
    <string name="gate_subtitle">在{tv}上更改任何内容之前</string>
    <string name="gate_negative">取消</string>
    <string name="gate_failed">我们无法确认您的身份，因此没有任何更改。</string>

    <!-- M3 Cards and modules -->
    <string name="modules_title">卡片和模块</string>

    <!-- M3c Look at the TV (card prompt, D1 and D45) -->
    <string name="cardprompt_title">查看 </string>
    <string name="cardprompt_art_keep">保持隐藏</string>
    <string name="cardprompt_art_cd">电视提问：{name}希望在您的主屏幕上显示一张卡片。按键 {key}。选项包括“保持隐藏”和“显示卡片”。</string>
    <string name="cardprompt_body">电视会与您再次确认，因此没有应用程序可以在未经询问的情况下将自己添加到主屏幕。</string>
    <string name="cardprompt_instruction">使用遥控器选择“显示卡片”。电视上的按键应显示{key}，与此处相同。</string>
    <string name="cardprompt_waiting">正在等待您在电视上的回答……</string>
    <string name="cardprompt_later">稍后再操作：长按电视上的“设置”按钮，找到“模块卡”。</string>
    <string name="cardprompt_shown">{name}位于主屏幕上。</string>
    <string name="cardprompt_hidden">{name}已安装并隐藏。它仍然显示为普通应用。您可以随时从“卡片和模块”中显示该卡片。</string>
    <string name="cardprompt_signer_changed">新版 {name} 的签名密钥与之前不同。这很不寻常；电视机故意再次询问。如果您没有预期会进行更新，请选择“保持隐藏”。</string>

    <!-- Module list (index) failures. Calm, never blame the user. -->
    <string name="index_failure_bad_signature">我们无法确认模块列表是否真实，因此没有使用它。电视上的任何内容均未被触碰。</string>
    <string name="index_failure_unknown_key">模块列表使用我们无法识别的密钥签名，因此我们没有使用它。电视上的任何内容均未被触碰。</string>
    <string name="index_failure_revoked_key">模块列表使用已撤销的密钥签名，因此我们没有使用它。电视上的任何东西都没有被碰过。</string>
    <string name="index_failure_bad_keys_file">受信任密钥列表未通过我们的检查，因此我们没有使用模块列表。电视上的任何内容均未被触及。</string>
    <string name="index_failure_expired">模块列表已过期。请连接到互联网并刷新。</string>
    <string name="index_failure_rollback">我们收到的模块列表比我们已有的列表更旧，因此我们保留了较新的列表。</string>
    <string name="index_failure_malformed">我们无法读取模块列表。请稍后再试。</string>
    <string name="index_stale_warning">模块列表可能已过期；请在联网时刷新</string>

    <!-- Download (fetch) failures -->
    <string name="fetch_failure_offline">此手机目前未连接到互联网。请连接并重试。</string>
    <string name="fetch_failure_host_not_allowed">该下载内容并非来自我们使用的来源，因此我们已停止下载。未安装任何内容。</string>
    <string name="fetch_failure_http_error">下载站点返回了错误 ({code})。请稍后再试。</string>
    <string name="fetch_failure_too_large">该下载文件比预期大，因此我们已停止下载。未安装任何内容。</string>
    <string name="fetch_failure_hash_mismatch">下载内容与作者的副本不匹配，因此我们未安装。</string>
    <string name="fetch_failure_size_mismatch">下载内容的大小与列表中显示的大小不符，因此我们已停止下载。未安装任何内容。</string>
    <string name="fetch_failure_signer_mismatch">该应用由列表中的作者以外的其他人签名，因此我们未安装该应用。</string>
    <string name="fetch_failure_try_again">再试一次</string>

</resources>
    <string name="restore_row_factory_sub">重新打开设置向导，以便重置后电视可以正常启动。</string>

    <!-- Undo everything: preview (UX 4.13) -->
    <string name="restore_preview_title">这让电视回到了{date}的状态：</string>
    <string name="restore_preview_things">{count, plural, one {重新启用#项内容} other {重新启用#项内容}}</string>
    <string name="restore_preview_home">电视自己的主屏幕（ {name} ）重新掌管</string>
    <string name="restore_preview_wizard">重新打开安装向导</string>
    <!-- RFC-HELPER-1 (test build): Undo everything takes the Home button helper out -->
    <string name="restore_preview_helper">主页按钮助手已关闭</string>
    <string name="restore_preview_screensaver">时钟屏幕保护程序回到电视自己的时钟屏幕保护程序</string>
    <string name="restore_preview_keyboard">键盘回到电视机自身</string>
    <string name="restore_launcher_title">主屏幕</string>
    <string name="restore_launcher_keep">保持作为普通应用程序安装</string>
    <string name="restore_launcher_remove">从电视上取下</string>
    <string name="restore_launcher_remove_note">删除它还会删除电视上模块卡给出的答案。</string>
    <string name="restore_preview_button">把所有东西都放回去</string>

    <!-- Undo everything: confirmation sheet -->
    <string name="restore_confirm_title">把所有东西都放回去？</string>
    <string name="restore_confirm_body">广告和跟踪也回来了。您可以随时再次进行清理。</string>
    <string name="restore_confirm_button">把所有东西都放回去</string>

    <!-- Undo everything: narration and end -->
    <string name="restore_working_title">把所有东西都放回去</string>
    <string name="restore_working_things">{total, plural, other {正在重新启动： {done}/#...}}</string>
    <string name="restore_working_home">正在将电视机自己的主屏幕放回……</string>
    <string name="restore_working_wizard">正在重新打开设置向导...</string>

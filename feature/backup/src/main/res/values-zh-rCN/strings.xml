    <string name="restore_clean_again">再次安装</string>

    <!-- Before a factory reset -->
    <string name="restore_factory_title">出厂重置前</string>
    <string name="restore_factory_body">出厂重置将使电视的设置向导恢复，因此我们现在将其重新打开，之后电视可以正常启动。</string>
    <string name="restore_factory_button">重新打开向导</string>
    <string name="restore_factory_working">正在重新打开设置向导...</string>
    <string name="restore_factory_done">设置向导已重新打开。您现在可以重置电视。</string>

    <!-- Save a copy (export) -->
    <string name="restore_export_saved">已保存还原点的副本。</string>
    <string name="restore_export_failed">我们无法保存副本。请尝试其他地方。</string>

</resources>
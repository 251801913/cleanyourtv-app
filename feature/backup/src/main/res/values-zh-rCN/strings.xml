<?xml version='1.0' encoding='UTF-8'?>
<!--
  Clean Your TV, :feature:backup. English source strings.
  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
  no Android plurals elements. Counts go through the plural selector.
  Screens: M6 Restore point, the undo preview and confirmation (UX 4.13), export, before a factory reset.
--><resources>

    <!-- Shared button words -->
    <string name="action_back">返回</string>
    <string name="action_cancel">取消</string>
    <string name="action_ok">确定</string>
    <string name="action_done">完成</string>

    <!-- Credential prompt (D17), raised by "Put everything back" -->
    <string name="gate_title">确认您的身份</string>
    <string name="gate_subtitle">在{tv}上更改任何内容之前</string>
    <string name="gate_negative">取消</string>
    <string name="gate_failed">我们无法确认您的身份，因此没有任何更改。</string>

    <!-- M6 Restore point -->
    <string name="restore_title">还原点</string>
    <string name="restore_current">保存于{date}</string>
    <string name="restore_none">还没有还原点。在第一次更改之前保存一个。</string>
    <string name="restore_read_failed">读取还原点时出错</string>
    <string name="restore_row_undo">撤消所有操作</string>
    <string name="restore_row_undo_sub">将电视恢复到{date}时的状态</string>

<?xml version='1.0' encoding='UTF-8'?>
<!--
  Clean Your TV, :feature:connect. English source strings.
  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
  no Android plurals elements. Counts go through the plural selector.
  Screens: S1, S1b, S1c, S2a to S2d, S2x, the "I don't see it" sheet, the stop cards for finding
  and reaching the TV. The Wi-Fi name is never shown (D19).
--><resources>

    <!-- Shared button words -->
    <string name="action_back">返回</string>
    <string name="action_cancel">取消</string>
    <string name="action_ok">确定</string>

    <!-- S1 Welcome. The overline is the product name, as on the TV launcher. -->
    <string name="welcome_title">你的电视，收拾好了。</string>
    <string name="welcome_body">关闭杂乱，保留您使用的应用程序，并获得平静的主屏幕。五分钟。一切都可以放回去。</string>
    <string name="welcome_hero_cd">一个充满赞助行的电视主屏幕变成一个干净的主屏幕，底部有四个应用程序</string>
    <string name="welcome_looking">正在查找Wi-Fi上的电视...</string>
    <string name="welcome_found_one">找到{name} （ {room} ）</string>
    <string name="welcome_found_one_noroom">找到{name}</string>
    <string name="welcome_found_many">{count, plural, one {找到#个电视} other {找到#个电视}}</string>
    <string name="welcome_none_yet">还没有电视。继续，我们会继续寻找。</string>
    <string name="welcome_start">启动</string>
    <string name="welcome_returning">我以前设置过电视机</string>

    <!-- S1b Which TV? -->
    <string name="picker_title">哪个电视？</string>
    <string name="picker_body">不确定？您选择的电视稍后会在屏幕上显示一条消息。</string>
    <string name="picker_row">{name} ， {room} · {platform}</string>
    <string name="picker_row_noroom">{name} · {platform}</string>
    <string name="picker_name_with_suffix">{name} ...{suffix}</string>
    <string name="picker_platform_android_tv">Android TV {version}</string>
    <string name="picker_platform_google_tv">Google TV {version}</string>
    <string name="picker_platform_fire_tv">Fire TV</string>
    <string name="picker_footer">手机和电视必须在同一台无线网络上。</string>
    <string name="picker_primary">使用 {name}</string>
    <string name="picker_tertiary">输入电视地址</string>

    <!-- S1c Enter the TV's address (sheet): its words are in ui/design (AddressEntry) -->

    <!-- S2a Let the phone in (steps) -->
    <string name="door_title">让手机进入</string>
    <string name="door_body">拿起电视遥控器。这大约需要一分钟，是唯一繁琐的部分。</string>
    <string name="door_step_cd">第{current}步，共{total}步</string>
    <string name="door_next">下一步</string>
    <string name="door_menu_names_vary">电视上的菜单名称可能略有不同。</string>
    <string name="door_same_wifi">手机和电视必须在同一台无线网络上。</string>
    <string name="door_waiting">正在等待电视...</string>
    <string name="door_connecting">连接中...</string>
    <string name="door_still_waiting">仍在等待。USB调试是否已打开？有些电视也需要网络调试。</string>
    <string name="door_still_waiting_show_me">作品展示</string>
    <string name="door_change_model">不是{model} ？更改模型</string>
    <string name="door_change_model_generic">不是此电视？更改型号</string>
    <!-- Round 3: the S1b tertiary's words, for a door Start opened on the one device found -->
    <string name="door_not_this_tv">不是这台电视机？请输入电视机地址</string>
    <string name="door_brand_prompt">哪个品牌？</string>
    <string name="door_brand_xiaomi">小米</string>
    <string name="door_brand_tcl">TCL</string>
    <string name="door_brand_sony">索尼</string>
    <string name="door_brand_hisense">海信</string>
    <string name="door_brand_philips">飞利浦</string>
    <string name="door_brand_google">Google</string>
    <string name="door_brand_amazon">0亚马逊</string>
    <string name="door_brand_other">其他种族</string>
    <!-- After the TCL chip: China-market TCL firmware and TCL's Android TV or Google TV need different steps. -->
    <string name="door_tcl_menus_prompt">电视节目会显示哪些菜单？</string>
    <string name="door_tcl_menus_global">英语或我的语言菜单</string>
    <string name="door_tcl_menus_chinese">中文菜单</string>
    <!-- 0.3.6: the TV's port answered but the connection failed; {kind} is a short code such as unreachable -->
    <string name="door_connect_failed_title">电视应答，但此手机无法连接</string>
    <string name="door_connect_failed_body">连接失败（ {kind} ）。打开此屏幕后，我们将继续尝试。</string>
    <string name="door_connect_failed_hint">如果电脑上的ADB正常工作，但此应用程序无法连接到电视，则手机上的某些内容可能会妨碍：每个应用程序的网络限制（ MIUI、Samsung ）、VPN、私人DNS或移动数据。请将其关闭一段时间，然后重试。</string>
    <!-- 0.4.8: the TV turned the connection away (refused): nothing listens on its debugging port. {kind} is the short code, refused -->
    <string name="door_connect_refused_title">电视上的调试已关闭</string>
    <string name="door_connect_refused_body">电视关闭了连接（ {kind} ） ，因此调试已关闭。设置结束时，我们会故意将其关闭，因此我们之前设置的电视上应该会出现这种情况。</string>
    <string name="door_connect_refused_hint">要重新打开：在电视上，打开“设置” ，然后打开“设备首选项”或“系统” ，再打开“开发人员选项” ，然后打开“USB调试”。打开此屏幕后，我们将继续尝试。</string>
    <string name="door_copy_error">复制错误</string>
    <string name="door_error_copied">已复制。将其粘贴到您的问题中。</string>
    <!-- 0.4.6: under a connect that failed; opens the GitHub form with the phone's side filled in. The wording of every report button. -->
    <string name="connect_report">上报软件问题</string>
    <string name="door_unknown_note">我们以前从未见过这台电视。步骤通常是相同的。</string>

    <!-- S2a step cards by platform family (UX 2 table). Note to translators: match the TV's own menu names. -->
    <!-- Android TV 9 to 11 -->
    <string name="family_atv_step1">在电视上，打开“设置” （齿轮，右上角） ，然后打开“设备偏好设置” &gt; “关于”。在“构建”上按“确定”七次，直到电视显示“您现在是开发人员”。</string>
    <string name="family_atv_step2">返回一个屏幕。打开开发人员选项并打开USB调试。如果电视还显示“网络调试”或“ADB调试” ，请将其打开。</string>
    <string name="family_atv_step3">将电视留在此屏幕上。您的手机将自行连接。</string>
    <string name="family_atv_extra_shield">在盾牌上， “网络调试”是最重要的。</string>
    <!-- Google TV 12 to 14 -->
    <string name="family_gtv_step1">在电视上，打开“设置” ，然后打开“系统” &gt; “关于”。在“Android TV OS build”上按OK七次，直到电视显示“您现在是一名开发人员”。</string>
    <string name="family_gtv_step2">返回一个屏幕。打开系统&gt;开发人员选项并打开USB调试，然后再打开无线调试。</string>
    <string name="family_gtv_step3">将电视留在此屏幕上。您的手机将自行连接。</string>
    <!-- Fire TV (Fire OS 7) -->
    <string name="family_fire_step1">在电视上，打开“设置” &gt; “我的Fire TV” &gt; “关于”。选择设备名称七次，直到电视显示“您现在是开发人员”。</string>
    <string name="family_fire_step2">返回一个屏幕。打开开发人员选项并打开ADB调试。</string>
    <string name="family_fire_step3">将电视留在此屏幕上。您的手机将自行连接。</string>
    <!-- TCL China (Android 9) -->
    <string name="family_tcl_step1">在电视上，打开“设置” &gt; “关于” &gt; 本机信息，然后按遥控器上的“向上”、“向下”、“向左”、“</string>
    <string name="family_tcl_step2">出现一个带有地址的小“ADB”窗口。保持打开状态。</string>
    <string name="family_tcl_step3">将电视留在此屏幕上。您的手机将自行连接。</string>
    <!-- TCL outside China (menus in English or the person's language): the Android TV steps plus these lines on steps 1 and 2 -->
    <string name="family_tcl_extra_gtv_step1">在Google TV上：系统&gt;关于，然后在“Android TV OS build”上按OK七次。</string>
    <string name="family_tcl_extra_gtv">在Google TV上，还可以开启无线调试。</string>
    <!-- Unknown brand: the generic Android TV path -->
    <string name="family_unknown_step1">在电视上，打开“设置” （齿轮，右上角） ，然后打开“设备偏好设置” &gt; “关于”。在“构建”上按“确定”七次，直到电视显示“您现在是开发人员”。</string>
    <string name="family_unknown_step2">返回一个屏幕。打开开发人员选项并打开USB调试。如果电视还显示“网络调试”或“ADB调试” ，请将其打开。</string>
    <string name="family_unknown_step3">将电视留在此屏幕上。您的手机将自行连接。</string>

    <!-- S2a profile banners (UX 2 and 4.15) -->
    <string name="banner_fire">Fire TV允许我们关闭广告和跟踪，但保留自己的主屏幕。你仍然可以得到清理。</string>
    <string name="banner_tcl">这台电视有自己的主屏幕（ TCL不允许其他人使用）。你仍然可以得到清理。</string>
    <string name="banner_mibox_usb">调试开启时，此盒子会关闭其USB端口。USB扬声器或驱动器将停止，直到我们完成（我们在最后再次关闭调试）。</string>

    <!-- S2c Look at the TV (Allow) -->
    <string name="allow_title">查看 </string>
    <string name="allow_body">电视询问是否信任这款手机。勾选“始终允许” ，然后选择“确定”。</string>
    <!-- The two parts of allow_body shown in text.primary; each must appear in allow_body exactly. -->
    <string name="allow_body_emphasis_always">始终允许</string>
    <string name="allow_body_emphasis_ok">好吧</string>
    <string name="allow_code_label">电视上的代码结尾是</string>
    <string name="allow_code_caption">就是这部手机。</string>
    <string name="allow_waiting">正在等待您轻触电视...</string>
    <string name="allow_still_waiting">仍在电视上等待OK。</string>
    <string name="allow_trusted">可信</string>
    <string name="allow_dont_see">我没有在电视上看到它</string>
    <string name="allow_art_cd">电视的“允许USB调试”框。指纹以{tail}结尾。</string>

    <!-- S2c sheet: I don't see it on the TV (UX 4.4) -->
    <string name="notseen_title">我没有在电视上看到它</string>
    <string name="notseen_hidden">该框可以隐藏在另一个屏幕后面。按遥控器上的Home （主页） ，然后按Back （返回）。如果仍然没有，我们将再次询问电视。</string>
    <string name="notseen_cancelled">如果有人选择取消：在电视上关闭并再次打开USB调试，然后点击“再次询问电视”。</string>
    <string name="notseen_greyed">如果电视上“始终允许”显示为灰色，则可以单独使用；我们下次会再次询问。</string>
    <string name="notseen_ask_again">再次询问电视</string>
    <string name="notseen_asking">再问一次电视……</string>
    <string name="notseen_restart">电视不接受手机。在电视完成启动之前打开调试时，少数型号会发生这种情况。重新启动电视，再次打开调试，然后返回。</string>
    <string name="notseen_restarted">我已重新启动</string>

    <!-- S2d Connected, and the identity check "Is this your TV?" (D38) -->
    <string name="connected_title">已连接到{tv}</string>
    <string name="connected_cd">已連線</string>
    <string name="identity_question">这是您的电视吗？</string>
    <string name="identity_detail">{name} ，序列结尾为{serial}</string>
    <string name="identity_body">请检查图片是否正是您的电视当前显示的内容。</string>
    <string name="identity_screenshot_cd">电视正在播放的内容</string>
    <string name="identity_yes">是的，那是我的</string>
    <string name="identity_no">否</string>

    <!-- S2x Pairing needed (D9). The three commands are code and are not translated. -->
    <string name="pairing_title">此电视需要配对码</string>
    <string name="pairing_body">此版本尚无法键入配对代码；下一个版本可以。如果您有一台电脑，请与adb配对并运行adb tcpip 5555 ，然后再回来；手机会从那里拿走它。</string>
    <string name="pairing_show_steps">显示电脑步骤</string>
    <string name="pairing_steps_title">从计算机配对一次</string>
    <string name="pairing_steps_intro">在电视上，打开开发者选项&gt;无线调试&gt;将设备与配对代码配对。然后在计算机上运行这三个命令，一次一个。</string>
    <string name="pairing_steps_note">使用电视节目的地址、端口和六位数代码。最后一条命令运行后，请返回此应用。电视重新启动后，使用电视显示的端口再次运行最后两个命令；无需再次配对。</string>

    <!-- Stop: TV not found (UX 4.1, no Wi-Fi name, D19) -->
    <string name="stop_tv_not_found_title">尚未找到电视</string>
    <string name="stop_tv_not_found_body">请确保电视已打开，并与这款手机使用相同的无线网络。电视醒来后可能需要一分钟才会出现。</string>
    <string name="stop_tv_not_found_primary">继续看</string>
    <string name="stop_tv_not_found_secondary">输入电视地址</string>
    <string name="stop_tv_not_found_tertiary">帮助</string>
    <string name="stop_tv_not_found_help_title">电视可能无法显示的原因</string>
    <string name="stop_tv_not_found_help_isolation">房客使用无线网络，或将设备隔开的路由器。向路由器询问“AP隔离”或“客户端隔离” ，并将其关闭。</string>
    <string name="stop_tv_not_found_help_ethernet">电视接入以太网，手机接入无线网络。这在大多数路由器上都很好，但有些路由器将两者分开。键入电视的地址会绕过它。</string>
    <string name="stop_tv_not_found_help_mesh">具有独立访客网络的网状系统。将手机连接到主网络。</string>

    <!-- Stop: wrong network (UX 4.2 with D19 copy) -->
    <string name="stop_wrong_network_title">手机和电视在不同的网络上</string>
    <string name="stop_wrong_network_body">电视最后一次出现在另一个网络上。使用与电视相同的无线网络，我们将继续使用。</string>
    <string name="stop_wrong_network_primary">Wi-Fi设置</string>
    <string name="stop_wrong_network_secondary">我在右边，请再看一遍</string>
    <string name="stop_wrong_network_off_title">此手机未使用Wi-Fi</string>
    <string name="stop_wrong_network_off_body">无线网络已关闭。电视只能通过相同的无线网络连接。</string>

    <!-- Stop: identity changed (D37) -->
    <string name="stop_identity_changed_title">另一台电视在此地址应答</string>
    <string name="stop_identity_changed_body">此地址的电视不是我们设置为{name}的电视。其地址可能已更改，或已被另一台电视占用。我们在改变任何东西之前都停了下来。</string>
    <string name="stop_identity_changed_primary">再找一遍</string>
    <string name="stop_identity_changed_secondary">返回</string>

    <!-- Stop: shell v2 missing (F1) -->
    <string name="stop_tv_not_supported_title">此电视还不能通过手机设置</string>
    <string name="stop_tv_not_supported_body">这台电视的调试连接太基础了，手机无法安全地进行更改，所以我们在触摸任何东西之前都停了下来。电视上的任何东西都没有改变。</string>
    <string name="stop_tv_not_supported_primary">返回</string>

</resources>
<?xml version='1.0' encoding='UTF-8'?>
<!--
  Clean Your TV, :feature:launcher. English source strings.
  Every string that takes an argument is ICU MessageFormat with NAMED arguments in braces,
  formatted by the app's message helper (android.icu.text.MessageFormat). No printf placeholders,
  no Android plurals elements. Counts go through the plural selector.
  Screens: M2 Home screen, the theme picker, the dock sheet (S3b, own copy in this module).
--><resources>

    <!-- Shared button words -->
    <string name="action_back">返回</string>
    <string name="action_cancel">取消</string>
    <string name="action_done">完成</string>
    <string name="action_undo">撤销</string>

    <!-- Credential prompt (D17), raised by "Send mine again" and "Use the TV's own home screen" -->
    <string name="gate_title">确认您的身份</string>
    <string name="gate_subtitle">在 {tv}上更改任何内容之前</string>
    <string name="gate_negative">取消</string>
    <string name="gate_failed">我们无法确认您的身份，因此没有任何更改。</string>

    <!-- M2 Home screen -->
    <string name="home_title">主屏幕</string>
    <string name="home_row_dock">【10】水库</string>
    <!-- The Dock row's subtitle when rows sit under the dock: the dock's apps, then how many more -->
    <string name="home_row_dock_rows">{names} ，外加{count, plural, one {#个应用} other {#个应用}}</string>
    <string name="home_row_look">查看</string>
    <string name="home_tcl_remote_keys">在TCL Google TV上，遥控器的设置（齿轮）、Netflix和YouTube按钮无法与新的主屏幕配合使用。要取回它们，请选择使用电视自己的主屏幕。</string>
    <!-- Issue #3059: a Google TV of another brand than TCL, whose remote's Settings button may stop working -->
    <string name="home_google_tv_settings_key">在Google TV上，遥控器的“设置” （ GEAR ）按钮会打开Google TV自己的设置面板，在许多电视上，该面板还具有您正在观看的输入的图片和声音设置。使用新的主屏幕时，它可能会停止工作。要取回它，请选择使用电视自己的主屏幕。</string>
    <string name="home_row_stock">使用电视机自己的主屏幕</string>
    <string name="home_row_stock_note">带回电视自己的主屏幕。我们的房源保持安装状态，因此您可以再次切换。</string>
    <string name="home_drift_banner">设置主屏幕设置后，电视上的主屏幕设置发生了变化。</string>
    <string name="home_drift_restore">再次发送我的</string>
    <string name="home_applying">正在更新电视上的主屏幕...</string>
    <string name="home_snackbar_done">完成。</string>

    <!-- 0.3.3 D2 (issue #3): the new home screen isn't on this TV, so there is no dock or look to change.
         The lead, then why (the reason Setup recorded), then what can change it, when something can. -->
    <string name="home_not_on_tv_lead">{tv} 保留自己的主屏幕。坞站和外观属于新的主屏幕，它不在这台电视上。</string>
    <string name="home_not_on_tv_refuses">{brand} 只允许自己的主屏幕，因此设置没有添加我们的主屏幕。没有它，清理工作就开始了。</string>
    <string name="home_not_on_tv_old_android">新的主屏幕需要Android 8或更高版本，因此安装程序未添加它。没有它，清理工作就开始了。</string>
    <string name="home_not_on_tv_unknown_home">我们不太了解这台电视的主屏幕，无法安全地切换，因此安装程序将其单独保留。</string>
    <string name="home_not_on_tv_wizard_wifi">此电视的Wi-Fi已通过其设置向导保存。新的主屏幕需要关闭向导，这会忘记Wi-Fi ，并且将向导留在电视上可能会崩溃。因此，安装程序独自离开了主屏幕。</string>
    <string name="home_not_on_tv_wizard_wifi_unlisted">这台电视的Wi-Fi是由其设置向导保存的，我们还不够了解这台电视，无法安全地关闭向导。如果向导保持开启状态，新的主屏幕可能会使电视崩溃，因此安装程序不会影响它。</string>
    <string name="home_not_on_tv_wizard_wifi_unknown">我们无法检查谁保存了此电视的Wi-Fi。新的主屏幕需要关闭设置向导，这可能会忘记Wi-Fi ，因此安装程序只留下主屏幕。</string>
    <string name="home_not_on_tv_casting">在此Google设备上，新的主屏幕需要关闭设置向导，然后每次重新启动后，从手机进行投射将停止工作。因此，安装程序独自离开了主屏幕。</string>
    <string name="home_not_on_tv_boot_loop">在这个电视系列中，设置向导在每次重新启动时都会返回，并且电视机自己的主屏幕关闭时，电视机可能无法启动。因此，安装程序独自离开了主屏幕。</string>
    <string name="home_not_on_tv_remote_buttons">在这台电视上，遥控器的应用程序按钮只能通过自己的主屏幕工作，因此安装程序不会影响主屏幕。</string>
    <string name="home_not_on_tv_wizard_stays_on">我们对这台电视的了解不足以关闭其设置向导，如果向导保持打开状态，电视的主屏幕关闭，电视可能会崩溃。因此，安装程序独自离开了主屏幕。</string>
    <string name="home_not_on_tv_home_changed">此电视的主屏幕已被其他应用或更早的更改更改，因此安装程序将其保持不变，并且未添加我们的主屏幕。没有它，清理工作就开始了。</string>
    <!-- beta3: the home screen was left alone by Setup with an earlier version of the app or another list -->
    <string name="home_not_on_tv_earlier">安装程序在上次运行时只留下主屏幕，但此应用程序已更改，现在可能会添加新的主屏幕。</string>
    <string name="home_not_on_tv_other_home">此电视上设置了另一个主屏幕应用程序，因此安装程序不会影响主屏幕。</string>
    <string name="home_not_on_tv_next_other_home">若要使用新应用，请删除该应用，然后再次运行安装程序。或者通过报告问题告诉我们。</string>
    <!-- beta4: a system service also answers Home (issue #825) -->
    <string name="home_not_on_tv_vendor_home">在这台电视上，系统服务还会响应主页按钮。这样的电视在切换主屏幕后无法启动，因此安装程序只留下主屏幕。</string>
    <!-- beta4: PatchWall stays on while Mi TV+ or its web content is off, not by this app (issue #945) -->
    <string name="home_not_on_tv_patchwall_feeds">当Mi TV +或其网络内容关闭时， PatchWall处于打开状态。这样的电视在切换主屏幕后无法启动，因此安装程序只留下主屏幕。</string>
    <string name="home_not_on_tv_next_patchwall_feeds">要使用新的安装程序，请再次运行安装程序，然后在“自定义”中关闭PatchWall。</string>
    <string name="home_not_on_tv_none">此电视上目前未安装新的主屏幕。</string>
    <string name="home_not_on_tv_next_wifi">要更改此设置，请忘记电视上保存的每个Wi-Fi网络，然后重新加入。电缆本身并不会改变它。然后再次运行安装程序。</string>
    <string name="home_not_on_tv_next_check">再次运行安装程序将再次检查。</string>
    <string name="home_not_on_tv_next_home_changed">如果您需要新的主屏幕，请在电视设置中将电视机自己的主屏幕设置为主屏幕，然后再次运行设置。</string>
    <string name="home_not_on_tv_next_setup">再次运行安装程序以添加它。</string>
    <string name="home_not_on_tv_next_list">什么会改变这一点是为这台电视制作的清单。帮助添加此电视会将其报告发送给我们；我们会根据与您类似的报告创建列表，并在有问题可供尝试时发布在您的问题中。</string>
    <string name="home_run_setup_again">再次安装</string>
    <string name="home_help_add_tv">帮助添加此电视</string>
